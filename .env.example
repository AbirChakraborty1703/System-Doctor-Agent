# LLM selection: openai | gemini | fallback
LLM_PROVIDER=fallback

# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Troubleshooting flow controls
MAX_QUESTIONS=6
MIN_CONFIDENCE_TO_STOP_QUESTIONS=0.72
MAX_VERIFICATION_LOOPS=3

# Optional online search enrichment (safe and allowlisted)
ONLINE_SEARCH_ENABLED=true
ONLINE_SEARCH_TIMEOUT_SECONDS=4
ONLINE_SEARCH_MAX_RESULTS=4
ONLINE_SEARCH_TRUSTED_DOMAINS=support.microsoft.com,learn.microsoft.com,apple.com,support.apple.com,ubuntu.com,help.ubuntu.com,debian.org,archlinux.org,docs.kernel.org,intel.com,nvidia.com,amd.com

# Optional Foundry endpoints for future hosted agent integration
FOUNDRY_PROJECT_ENDPOINT_DEV=
FOUNDRY_PROJECT_ENDPOINT_STAGING=
FOUNDRY_PROJECT_ENDPOINT_PROD=
FOUNDRY_MODEL_TRIAGE_DEV=
FOUNDRY_MODEL_DIAGNOSIS_DEV=
FOUNDRY_MODEL_REMEDIATION_DEV=
