# ------------------------------------------------------------
# SystemDoctor AI - Git Ignore Rules
# Production-safe exclusions for secrets, local runtime files,
# caches, and generated artifacts.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Environment and Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# Secrets and credentials
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.kubeconfig
*.ovpn
*secret*
*secrets*
*credential*
*credentials*
*token*
auth.json
credentials.json
token.json
service-account*.json
gcp-service-account*.json
azure-auth*.json

# ------------------------------------------------------------
# Python Artifacts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
__pypackages__/

# Tool caches
.pytest_cache/
.pytest_cache_runtime/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/

# Coverage / build / packaging outputs
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
site/
pip-wheel-metadata/
*.egg-info/

# Notebook and data science noise
.ipynb_checkpoints/

# ------------------------------------------------------------
# Streamlit and Local App Runtime
# ------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/cache/

# Local session/runtime database files
apps/streamlit/session_store.db
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------
# IDE / Editor / OS Junk
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Logs, Temp Files, and Runtime Caches
# ------------------------------------------------------------
*.log
*.out
*.err
logs/
*.tmp
*.temp
*.cache
cache/
tmp/
temp/
pytest-cache-files-*/

# Local helper/runtime folders
.sixth/

# ------------------------------------------------------------
# Foundry and AI Workflow Generated Artifacts
# Keep .foundry scaffold source files versioned.
# ------------------------------------------------------------
.foundry/results/
.foundry/logs/
.foundry/traces/
.foundry/cache/

# ------------------------------------------------------------
# Project-specific Generated Outputs
# ------------------------------------------------------------
eval/reports/*
!eval/reports/.gitkeep

